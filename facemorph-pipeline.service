[Unit]
Description=Face Morph Pipeline
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=zongze
WorkingDirectory=/home/zongze/Documents/video-face-morphing

# Point directly at the venv Python — no activation needed
ExecStart=/home/zongze/Documents/video-face-morphing/venv/bin/python \
    main_rpi.py shrek-square.mp4 \
    --landmark NORMAL \
    --feather-radius 50 \
    --port 9002

# Restart on crash, non-zero exit, or signal
Restart=always
RestartSec=5

# Kill if it hangs at startup
TimeoutStartSec=30

# Kill and restart if the render loop freezes for 30s
WatchdogSec=30

# View logs with: journalctl -u facemorph-pipeline -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
